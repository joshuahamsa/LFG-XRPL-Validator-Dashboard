#!/usr/bin/env bash
# XRPL Validator MOTD Renderer
# Writes a pre-rendered ANSI dashboard to /var/cache/motd-validator.
# Designed to be called by cron every 60s as root.
set -euo pipefail
export LC_ALL=en_US.UTF-8
export PATH="/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin"

# ── Load config ───────────────────────────────────────────────────────────────
# Primary: system-wide install. Dev fallback: git root config. Test mode (_SOURCED=1):
# caller sets VALIDATOR_JSON_DIR etc. directly, missing config is tolerated.
_SYSTEM_CONFIG="/etc/validator-node/validator.conf"
if [[ -f "$_SYSTEM_CONFIG" ]]; then
    source "$_SYSTEM_CONFIG"
else
    _git_root=""
    if command -v git &>/dev/null; then
        _git_root=$(git -C "$(dirname "$(readlink -f "$0")")" rev-parse --show-toplevel 2>/dev/null || true)
    fi
    if [[ -n "$_git_root" && -f "$_git_root/config/validator.conf" ]]; then
        source "$_git_root/config/validator.conf"
    elif [[ -z "${_SOURCED:-}" ]]; then
        echo "ERROR: config not found at $_SYSTEM_CONFIG. Run motd/setup.sh first." >&2
        exit 1
    fi
fi

VALIDATOR_JSON=""
CACHE_FILE="/var/cache/motd-validator"
CACHE_TMP="${CACHE_FILE}.tmp"

# ── xrpld node binding ────────────────────────────────────────────────────────
# xrpld is the renamed rippled package (3.2.0+). Overridable via validator.conf;
# old RIPPLED_* values are honoured as a fallback for not-yet-migrated installs.
XRPLD_BIN="${XRPLD_BIN:-${RIPPLED_BIN:-/usr/bin/xrpld}}"
XRPLD_UNIT="${XRPLD_UNIT:-${RIPPLED_UNIT:-xrpld}}"
XRPLD_ADMIN_RPC="${XRPLD_ADMIN_RPC:-127.0.0.1:5006}"

# ── ANSI color codes ──────────────────────────────────────────────────────────
# LFG palette, from my Starship config (starship-lfg.toml). 24-bit truecolor;
# frontend/styles.css uses the same hex values for the web dashboard.
RESET=$'\e[0m'
ORANGE=$'\e[38;2;216;144;48m'   # builder_orange #D89030
RED=$'\e[38;2;216;72;48m'       # effing_red     #D84830
BLUE=$'\e[38;2;72;144;192m'     # go_blue        #4890C0
YELLOW=$'\e[38;2;240;216;72m'   # hardhat_yellow #F0D848
GREEN=$'\e[38;2;61;163;93m'     # super_green    #3DA35D
CANVAS=$'\e[38;2;236;234;228m'  # canvas         #ECEAE4
DIM=$'\e[2m'

# ── Layout ────────────────────────────────────────────────────────────────────
LEFT_COL=38    # visible inner width of left column
RIGHT_COL=39   # visible inner width of right column
# Box total: ║(1) + LEFT_COL(38) + ╬(1) + RIGHT_COL(39) + ║(1) = 80

# ── Helper functions ──────────────────────────────────────────────────────────

# Right-pad a string to exactly N visible chars.
# Two usage patterns:
#   Plain text:    rpad "text" width
#                  width = desired visible chars
#   Pre-colored:   rpad "${COLOR}text${RESET}" $(( width + ${#COLOR} + ${#RESET} ))
#                  compensate for ANSI code bytes so visible width stays correct
rpad() {
    local str="$1" width="$2"
    local len=${#str}
    local pad=$(( width - len ))
    if (( pad <= 0 )); then
        printf '%s' "${str:0:$width}"
    else
        printf '%s%*s' "$str" "$pad" ""
    fi
}

# Center a plain-text string in N visible chars.
center_str() {
    local str="$1" width="$2"
    local len=${#str}
    if (( len >= width )); then
        printf '%s' "${str:0:$width}"
        return
    fi
    local lp=$(( (width - len) / 2 ))
    local rp=$(( width - len - lp ))
    printf '%*s%s%*s' "$lp" "" "$str" "$rp" ""
}

# 10-char progress bar with color based on percentage.
progress_bar() {
    local pct="$1"
    local filled=$(( pct * 10 / 100 ))
    (( filled > 10 )) && filled=10
    (( filled < 0  )) && filled=0
    local empty=$(( 10 - filled ))
    local bar="" i
    local color
    if   (( pct >= 81 )); then color="$RED"
    elif (( pct >= 61 )); then color="$ORANGE"
    else                       color="$GREEN"
    fi
    for (( i=0; i<filled; i++ )); do bar+="█"; done
    for (( i=0; i<empty;  i++ )); do bar+="░"; done
    printf '%s%s%s' "$color" "$bar" "$RESET"
}

# Format /proc/uptime seconds as "Xd XXh XXm".
format_uptime() {
    local raw="${1%% *}"    # strip from first space (handles "X.Y Z.W" format)
    local secs="${raw%.*}"  # strip decimal
    local d=$(( secs / 86400 ))
    local h=$(( (secs % 86400) / 3600 ))
    local m=$(( (secs % 3600) / 60 ))
    printf '%dd %02dh %02dm' "$d" "$h" "$m"
}

# ── Pre-built border strings (computed once at source time) ───────────────────
_hline() { local n="$1" s=""; for (( i=0; i<n; i++ )); do s+="═"; done; printf '%s' "$s"; }

_H78=$(_hline 78)
_H38=$(_hline 38)
_H39=$(_hline 39)

_BOX_TOP="╔${_H78}╗"
_BOX_BOT="╚${_H78}╝"
_BOX_MID="╠${_H78}╣"
_BOX_SPL="╠${_H38}╦${_H39}╣"   # open two-column split
_BOX_JOI="╠${_H38}╬${_H39}╣"   # mid two-column join
_BOX_CLS="╠${_H38}╩${_H39}╣"   # close two-column (╩ rejoins)

box_top()     { printf '%s%s%s\n' "$BLUE" "$_BOX_TOP" "$RESET"; }
box_bottom()  { printf '%s%s%s\n' "$BLUE" "$_BOX_BOT" "$RESET"; }
box_mid()     { printf '%s%s%s\n' "$BLUE" "$_BOX_MID" "$RESET"; }
box_split()   { printf '%s%s%s\n' "$BLUE" "$_BOX_SPL" "$RESET"; }
box_join()    { printf '%s%s%s\n' "$BLUE" "$_BOX_JOI" "$RESET"; }
box_close()   { printf '%s%s%s\n' "$BLUE" "$_BOX_CLS" "$RESET"; }

# Single-column content row. $1 must be exactly 78 *visible* chars; ANSI codes are allowed (they add no visible width).
# Wrap $1 in color codes BEFORE calling if needed; padding must be plain.
box_row() {
    printf '%s║%s%s%s║%s\n' "$BLUE" "$RESET" "$1" "$BLUE" "$RESET"
}

# Two-column content row. $1=38 visible chars, $2=39 visible chars (plain or pre-colored).
box_row2() {
    printf '%s║%s%s%s║%s%s%s║%s\n' \
        "$BLUE" "$RESET" "$1" "$BLUE" "$RESET" "$2" "$BLUE" "$RESET"
}

# ── LFG XRPL banner (figlet block font, 59 chars wide, 6 rows) ───────────────
# Each string is exactly 59 visible chars: LFG(25) + sep(2) + XRPL(32)
_BANNER=(
    "██╗     ███████╗ ██████╗   ██╗  ██╗██████╗ ██████╗ ██╗     "
    "██║     ██╔════╝██╔════╝   ╚██╗██╔╝██╔══██╗██╔══██╗██║     "
    "██║     █████╗  ██║  ███╗   ╚███╔╝ ██████╔╝██████╔╝██║     "
    "██║     ██╔══╝  ██║   ██║   ██╔██╗ ██╔══██╗██╔═══╝ ██║     "
    "███████╗██║     ╚██████╔╝  ██╔╝ ██╗██║  ██║██║     ███████╗"
    "╚══════╝╚═╝      ╚═════╝   ╚═╝  ╚═╝╚═╝  ╚═╝╚═╝     ╚══════╝"
)
# Centering: (78 - 59) / 2 = 9 left pad, 10 right pad
_BANNER_LPAD="         "   # 9 spaces
_BANNER_RPAD="          "  # 10 spaces

print_header() {
    local pubkey="unknown" manifest_seq="?" domain="${VALIDATOR_DOMAIN:-}"

    if [[ -n "$VALIDATOR_JSON" && -f "$VALIDATOR_JSON" ]]; then
        pubkey=$(jq -r '.public_key // "unknown"' "$VALIDATOR_JSON" 2>/dev/null)
        manifest_seq=$(jq -r '.token_sequence // "?"' "$VALIDATOR_JSON" 2>/dev/null)
        domain=$(jq -r --arg d "${VALIDATOR_DOMAIN:-}" '.domain // $d' "$VALIDATOR_JSON" 2>/dev/null)
    fi

    local key_short="${pubkey:0:6}···${pubkey: -4}"

    box_top
    local row
    for row in "${_BANNER[@]}"; do
        # LFG wordmark: L orange, F red, G blue (cols 0-7 / 8-15 / 16-24), XRPL canvas.
        # 9 spaces (plain) + colored banner + 10 spaces (plain) = 78 visible chars
        box_row "${_BANNER_LPAD}${ORANGE}${row:0:8}${RESET}${RED}${row:8:8}${RESET}${BLUE}${row:16:9}${RESET}${CANVAS}${row:25}${RESET}${_BANNER_RPAD}"
    done

    # Subtitle: "▸▸  domain  ·  key  ·  Manifest #N  ◂◂" centered in 78
    local plain_sub="▸▸  ${domain}  ·  ${key_short}  ·  Manifest #${manifest_seq}  ◂◂"
    local sub_len=${#plain_sub}
    local sub_lp=$(( (78 - sub_len) / 2 ))
    local sub_rp=$(( 78 - sub_len - sub_lp ))
    (( sub_lp < 0 )) && sub_lp=0
    (( sub_rp < 0 )) && sub_rp=0
    local lpad rpad
    printf -v lpad '%*s' "$sub_lp" ""
    printf -v rpad '%*s' "$sub_rp" ""
    box_row "${lpad}${CANVAS}${plain_sub}${RESET}${rpad}"
}

# ── Data collection (called once in main, sets globals) ───────────────────────

# Validator / xrpld globals
RPC_STATE="OFFLINE"
RPC_LEDGER_SEQ="—"
RPC_LEDGER_AGE="—"
RPC_LOAD="—"
RPC_PEERS="—"
RPC_PEER_DISC="—"
RPC_UPTIME_S="0"
RPC_AMENDMENT_BLOCKED="false"
RPC_VERSION="—"

# System globals
SYS_CPU_PCT=0
SYS_RAM_USED_GB="—"
SYS_RAM_TOTAL_GB="—"
SYS_RAM_PCT=0
SYS_DISK_USED="—"
SYS_DISK_TOTAL="—"
SYS_DISK_PCT=0
SYS_UPTIME="—"
SYS_CPU_TEMP_C=""
SYS_CPU_W=""

# Network globals
NET_LAN="—"
NET_TAILSCALE="—"
NET_SSH_SESSIONS=0
NET_P2P_STATUS="CLOSED"

# UPS globals (NUT). UPS_STATUS stays empty when there is no NUT/UPS, which hides the row.
UPS_STATUS=""
UPS_CHARGE=""
UPS_RUNTIME_S=""
UPS_LOAD=""
UPS_NOMINAL_W=""

# Alert globals (arrays)
ALERT_LINES=()

# Amendment globals
METRICS_JSON='{}'
AMD_JSON='[]'
AMD_ERROR=false

# Read the UPS via NUT's upsc. Leaves UPS_STATUS empty if NUT isn't installed or reachable.
collect_ups() {
    command -v upsc &>/dev/null || return 0
    local ups="${UPS_NAME:-}" out
    if [[ -z "$ups" ]]; then
        ups=$(timeout 3 upsc -l 2>/dev/null | head -1) || true
        [[ -n "$ups" ]] || return 0
        ups="${ups}@localhost"
    fi
    out=$(timeout 3 upsc "$ups" 2>/dev/null) || return 0
    parse_ups "$out"
}

# Parse `upsc` output (stdin-free: $1 is the text) into the UPS_* globals.
parse_ups() {
    local key val
    while IFS=': ' read -r key val; do
        case "$key" in
            ups.status)            UPS_STATUS="$val" ;;
            battery.charge)        UPS_CHARGE="$val" ;;
            battery.runtime)       UPS_RUNTIME_S="$val" ;;
            ups.load)              UPS_LOAD="$val" ;;
            ups.realpower.nominal) UPS_NOMINAL_W="$val" ;;
        esac
    done <<< "$1"
}

collect_data() {
    # ── xrpld ──
    local rpc_json
    if rpc_json=$(timeout 5 "$XRPLD_BIN" server_info 2>/dev/null); then
        RPC_STATE=$(printf '%s' "$rpc_json"   | jq -r '.result.info.server_state    // "unknown"')
        RPC_LEDGER_SEQ=$(printf '%s' "$rpc_json" | jq -r '.result.info.validated_ledger.seq // "—"')
        RPC_LEDGER_AGE=$(printf '%s' "$rpc_json" | jq -r '.result.info.validated_ledger.age // "—"')
        RPC_LOAD=$(printf '%s' "$rpc_json"    | jq -r '.result.info.load_factor      // "—"')
        RPC_PEERS=$(printf '%s' "$rpc_json"   | jq -r '.result.info.peers            // "—"')
        RPC_PEER_DISC=$(printf '%s' "$rpc_json" | jq -r '.result.info.peer_disconnects // "—"')
        RPC_UPTIME_S=$(printf '%s' "$rpc_json" | jq -r '.result.info.uptime          // "0"')
        RPC_VERSION=$(printf '%s' "$rpc_json"  | jq -r '.result.info.build_version   // "—"')
        local ab
        ab=$(printf '%s' "$rpc_json" | jq -r '.result.info.amendment_blocked // false')
        RPC_AMENDMENT_BLOCKED="$ab"
    fi

    # ── CPU: 1-min load / core count as percent ──
    local load_avg cores
    load_avg=$(awk '{print $1}' /proc/loadavg)
    cores=$(grep -c '^processor' /proc/cpuinfo)
    SYS_CPU_PCT=$(awk "BEGIN { v=int(($load_avg/$cores)*100); print (v>100?100:v) }")

    # ── RAM ──
    local total_kb avail_kb used_kb
    total_kb=$(awk '/^MemTotal:/{print $2}'     /proc/meminfo)
    avail_kb=$(awk '/^MemAvailable:/{print $2}' /proc/meminfo)
    used_kb=$(( total_kb - avail_kb ))
    SYS_RAM_PCT=$(( used_kb * 100 / total_kb ))
    SYS_RAM_USED_GB=$(awk "BEGIN { printf \"%.1f\", $used_kb/1048576 }")
    SYS_RAM_TOTAL_GB=$(awk "BEGIN { printf \"%.0f\",  $total_kb/1048576 }")

    # ── Disk ──
    read -r _ total used _ pct _ < <(df -h / | tail -1)
    SYS_DISK_TOTAL="$total"
    SYS_DISK_USED="$used"
    SYS_DISK_PCT="${pct%%%}"   # strip trailing %

    # ── Uptime ──
    local up_secs
    up_secs=$(awk '{print $1}' /proc/uptime)
    SYS_UPTIME=$(format_uptime "$up_secs")

    # ── Network ──
    NET_LAN=$(ip route get 8.8.8.8 2>/dev/null | grep -oP 'src \K[^ ]+' || echo "—")
    # Tailscale uses the 100.x.x.x range
    NET_TAILSCALE=$(ip addr show 2>/dev/null \
        | grep -oP '(?<=inet )100\.[0-9]+\.[0-9]+\.[0-9]+' | head -1 || echo "—")
    NET_SSH_SESSIONS=$(ss -tnp 2>/dev/null | awk '$1=="ESTAB" && $4 ~ /:22$/' | wc -l)
    if ss -tlnp 2>/dev/null | grep -q ':51235'; then
        NET_P2P_STATUS="OPEN"
    else
        NET_P2P_STATUS="CLOSED"
    fi

    # ── UPS (NUT) — optional; UPS_NAME may be set in validator.conf ──
    collect_ups

    # ── Alerts: last 3 notable xrpld log lines ──
    mapfile -t ALERT_LINES < <(
        journalctl -u "$XRPLD_UNIT" -n 60 --no-pager -o short-iso 2>/dev/null \
        | grep -iE 'warn|error|amendment|consensus lost|slow ledger' \
        | tail -3 \
        | awk '{
            ts = substr($1, 12, 5)
            $1=""; sub(/^ /, "")
            sub(/[^ ]+ [^ ]+\[[0-9]+\]: /, "")
            printf "[%s] %s\n", ts, substr($0, 1, 60)
          }'
    ) || true

    # ── Amendments: metrics server first, xrpld direct fallback ─────────────────
    local _metrics
    _metrics=$(curl -s --max-time 3 http://localhost:8080/metrics 2>/dev/null) || true
    if [[ -n "$_metrics" ]]; then
        METRICS_JSON="$_metrics"
        AMD_JSON=$(printf '%s' "$METRICS_JSON" | jq -c '.amendments // []' 2>/dev/null) \
            || AMD_ERROR=true
        SYS_CPU_TEMP_C=$(printf '%s' "$METRICS_JSON" | jq -r '.system.cpu_temp_c // empty' 2>/dev/null || true)
        SYS_CPU_W=$(printf '%s' "$METRICS_JSON" | jq -r '.system.cpu_w // empty' 2>/dev/null || true)
    else
        # Fallback: query xrpld directly. --rpc_ip is required for vetoed field.
        local _feat
        if _feat=$(sudo "$XRPLD_BIN" --rpc_ip="$XRPLD_ADMIN_RPC" feature 2>/dev/null); then
            AMD_JSON=$(printf '%s' "$_feat" | jq -c '
                [.result.features | to_entries[]
                 | select(.value.enabled == false and .value.vetoed != "Obsolete")
                 | {
                     name: (.value.name // ""),
                     vote: (if .value.vetoed == true then "no" else "yes" end),
                     supported: (.value.supported // false),
                     majority: (.value | has("majority"))
                   }
                ] | sort_by([if .majority then 0 else 1 end, .name])
            ' 2>/dev/null) || AMD_ERROR=true
        else
            AMD_ERROR=true
        fi
    fi
}

# ── Two-column body ───────────────────────────────────────────────────────────
# Left column:  VALIDATOR (incl. peers) over NETWORK.
# Right column: SYSTEM over POWER (POWER only when NUT reports a UPS).
# Each column is built as an array of cells (exactly LEFT_COL / RIGHT_COL visible
# chars) plus divider markers; print_columns zips them, padding the shorter
# column, and picks the right border joints where a divider meets a content row.
_COL_DIV=$'\x01DIV'
LCOL=()
RCOL=()

# Add a cell: $1 = array name, $2 = content (any colors), $3 = visible width of $2's plain text
# Callers build cells with rpad so they are already exactly column width.
_lcell() { LCOL+=("$1"); }
_rcell() { RCOL+=("$1"); }

# Section header cell, e.g. "  ◈ VALIDATOR" padded to width $2
_header_cell() {
    rpad "  ${YELLOW}◈ $1${RESET}" $(( $2 + ${#YELLOW} + ${#RESET} ))
}

# Left data row: 16-char label + value (22 visible), value pre-colored with $3
_lrow() {
    local label="$1" val="$2" color="${3:-$GREEN}"
    printf '    %-12s%s%s%s' "$label" "$color" "$(rpad "$val" $(( LEFT_COL - 16 )))" "$RESET"
}

# Right data row with bar: 12-char label + 10-char bar + 2 + value (15 visible)
_rbar() {
    local label="$1" bar="$2" val="$3" color="${4:-$GREEN}"
    printf '    %-8s%s  %s%s%s' "$label" "$bar" "$color" "$(rpad "$val" $(( RIGHT_COL - 24 )))" "$RESET"
}

# Right data row without bar: 12-char label + value (27 visible)
_rrow() {
    local label="$1" val="$2" color="${3:-$GREEN}"
    printf '    %-8s%s%s%s' "$label" "$color" "$(rpad "$val" $(( RIGHT_COL - 12 )))" "$RESET"
}

# 10-char bar for "higher is better" values (battery charge): green ≥50, orange ≥20, red below.
charge_bar() {
    local pct="$1" filled color bar="" i
    filled=$(( pct * 10 / 100 )); (( filled > 10 )) && filled=10; (( filled < 0 )) && filled=0
    if   (( pct >= 50 )); then color="$GREEN"
    elif (( pct >= 20 )); then color="$ORANGE"
    else                       color="$RED"
    fi
    for (( i=0; i<filled; i++ )); do bar+="█"; done
    for (( i=filled; i<10; i++ )); do bar+="░"; done
    printf '%s%s%s' "$color" "$bar" "$RESET"
}

build_validator_section() {
    _lcell "$(_header_cell VALIDATOR $LEFT_COL)"

    # State: bar + label (+ [BLOCKED])
    local state_color="$GREEN" state_bar
    if [[ "$RPC_STATE" == "full" || "$RPC_STATE" == "proposing" ]]; then
        state_bar="${GREEN}▓▓▓▓▓▓▓▓▓▓${RESET}"
    else
        state_color="$RED"; state_bar="${RED}░░░░░░░░░░${RESET}"
    fi
    local amend_warn="" amend_vis=0
    if [[ "$RPC_AMENDMENT_BLOCKED" == "true" ]]; then
        amend_warn=" ${RED}[BLOCKED]${RESET}"; amend_vis=10
    fi
    # "    State       "(16) + bar(10) + " "(1) + label + warn = 38
    _lcell "    State       ${state_bar} ${state_color}$(rpad "${RPC_STATE^^}" $(( LEFT_COL - 27 - amend_vis )))${RESET}${amend_warn}"

    local seq_fmt="$RPC_LEDGER_SEQ"
    [[ "$RPC_LEDGER_SEQ" =~ ^[0-9]+$ ]] && seq_fmt=$(printf '%d' "$RPC_LEDGER_SEQ" | sed ':a;s/\B[0-9]\{3\}\>/,&/;ta')
    _lcell "$(_lrow Ledger "$seq_fmt")"

    local age_color="$GREEN" age_num
    age_num=$(printf '%s' "$RPC_LEDGER_AGE" | grep -oP '^[0-9]+' || echo "0")
    (( age_num > 10 )) && age_color="$ORANGE"
    (( age_num > 30 )) && age_color="$RED"
    _lcell "$(_lrow Age "${RPC_LEDGER_AGE}s" "$age_color")"

    local load_color="$GREEN" load_num
    load_num=$(printf '%s' "$RPC_LOAD" | grep -oP '^[0-9]+(\.[0-9]+)?' || echo "0")
    (( $(awk "BEGIN{print ($load_num > 5) ? 1 : 0}") )) && load_color="$ORANGE"
    (( $(awk "BEGIN{print ($load_num > 20) ? 1 : 0}") )) && load_color="$RED"
    _lcell "$(_lrow Load "${RPC_LOAD}x" "$load_color")"

    local node_uptime="—"
    [[ "$RPC_UPTIME_S" =~ ^[0-9]+$ ]] && node_uptime=$(format_uptime "$RPC_UPTIME_S")
    _lcell "$(_lrow Uptime "$node_uptime")"
    _lcell "$(_lrow Version "$RPC_VERSION")"
}

build_network_section() {
    _lcell "$_COL_DIV"
    _lcell "$(_header_cell NETWORK $LEFT_COL)"
    _lcell "$(_lrow LAN "$NET_LAN")"
    _lcell "$(_lrow Tailscale "${NET_TAILSCALE:-—}")"
    _lcell "$(_lrow SSH "${NET_SSH_SESSIONS} active")"
    local p2p_color="$GREEN" p2p_sym="✓"
    [[ "$NET_P2P_STATUS" != "OPEN" ]] && { p2p_color="$RED"; p2p_sym="✗"; }
    _lcell "$(_lrow "P2P :51235" "${p2p_sym} ${NET_P2P_STATUS}" "$p2p_color")"

    local peer_color="$GREEN" peer_num
    peer_num=$(printf '%s' "$RPC_PEERS" | grep -oP '^[0-9]+' || echo "0")
    (( peer_num < 4  )) && peer_color="$ORANGE"
    (( peer_num == 0 )) && peer_color="$RED"
    _lcell "$(_lrow Peers "${RPC_PEERS} connected" "$peer_color")"

    local disc_color="$GREEN" disc_num
    disc_num=$(printf '%s' "$RPC_PEER_DISC" | grep -oP '^[0-9]+' || echo "0")
    (( disc_num > 10 )) && disc_color="$ORANGE"
    (( disc_num > 50 )) && disc_color="$RED"
    _lcell "$(_lrow Disconnects "$RPC_PEER_DISC" "$disc_color")"
}

build_system_section() {
    _rcell "$(_header_cell SYSTEM $RIGHT_COL)"
    _rcell "$(_rbar CPU  "$(progress_bar "$SYS_CPU_PCT")"  "${SYS_CPU_PCT}%")"
    _rcell "$(_rbar RAM  "$(progress_bar "$SYS_RAM_PCT")"  "${SYS_RAM_USED_GB} / ${SYS_RAM_TOTAL_GB} GB")"
    _rcell "$(_rbar Disk "$(progress_bar "$SYS_DISK_PCT")" "${SYS_DISK_USED} / ${SYS_DISK_TOTAL}")"
    if [[ -n "$SYS_CPU_TEMP_C" ]]; then
        local temp_color="$GREEN"
        (( SYS_CPU_TEMP_C >= 60 )) && temp_color="$ORANGE"
        (( SYS_CPU_TEMP_C >= 80 )) && temp_color="$RED"
        _rcell "$(_rrow Temp "${SYS_CPU_TEMP_C}°C" "$temp_color")"
    fi
    return 0
}

# POWER: UPS rows (only when NUT reports a UPS), then host uptime and CPU package power.
build_power_section() {
    _rcell "$_COL_DIV"
    _rcell "$(_header_cell POWER $RIGHT_COL)"
    [[ -n "$UPS_STATUS" ]] && build_ups_rows
    _rcell "$(_rrow "Host up" "$SYS_UPTIME")"
    [[ -n "$SYS_CPU_W" ]] && _rcell "$(_rrow "CPU W" "${SYS_CPU_W} W" "$CANVAS")"
    return 0
}

build_ups_rows() {

    local label="ON MAINS" color="$GREEN"
    case " $UPS_STATUS " in
        *" LB "*)   label="LOW BATTERY";      color="$RED" ;;
        *" OB "*)   label="ON BATTERY";       color="$ORANGE" ;;
        *" RB "*)   label="REPLACE BATTERY";  color="$ORANGE" ;;
        *" OVER "*) label="OVERLOAD";         color="$RED" ;;
        *" OL "*)   [[ " $UPS_STATUS " == *" CHRG "* ]] && label="ON MAINS · charging" ;;
        *)          label="${UPS_STATUS}";    color="$RED" ;;
    esac
    _rcell "$(_rrow State "$label" "$color")"

    if [[ "$UPS_CHARGE" =~ ^[0-9]+$ ]]; then
        _rcell "$(_rbar Batt "$(charge_bar "$UPS_CHARGE")" "${UPS_CHARGE}%")"
    fi
    if [[ "$UPS_RUNTIME_S" =~ ^[0-9]+$ ]]; then
        local rt_color="$GREEN"
        (( UPS_RUNTIME_S < 1200 )) && rt_color="$ORANGE"
        (( UPS_RUNTIME_S < 600 ))  && rt_color="$RED"
        _rcell "$(_rrow Left "$(( UPS_RUNTIME_S / 60 )) min runtime" "$rt_color")"
    fi
    if [[ "$UPS_LOAD" =~ ^[0-9]+$ ]]; then
        local load="${UPS_LOAD}%"
        [[ "$UPS_NOMINAL_W" =~ ^[0-9]+$ ]] && load+=" · ~$(( UPS_LOAD * UPS_NOMINAL_W / 100 )) W"
        _rcell "$(_rbar Load "$(progress_bar "$UPS_LOAD")" "$load")"
    fi
}

# Zip LCOL and RCOL into box rows, choosing border joints around dividers.
print_columns() {
    LCOL=(); RCOL=()
    build_validator_section
    build_network_section
    build_system_section
    build_power_section

    local n=${#LCOL[@]} i
    (( ${#RCOL[@]} > n )) && n=${#RCOL[@]}
    local blank_l blank_r
    blank_l=$(rpad "" $LEFT_COL)
    blank_r=$(rpad "" $RIGHT_COL)

    box_split
    for (( i=0; i<n; i++ )); do
        local l="${LCOL[i]-$blank_l}" r="${RCOL[i]-$blank_r}"
        local ld=false rd=false
        [[ "$l" == "$_COL_DIV" ]] && ld=true
        [[ "$r" == "$_COL_DIV" ]] && rd=true
        local lb="║" mid="║" rb="║"
        if $ld && $rd; then lb="╠"; mid="╬"; rb="╣"
        elif $ld;      then lb="╠"; mid="╣"
        elif $rd;      then mid="╠"; rb="╣"
        fi
        $ld && l="${BLUE}${_H38}${RESET}"
        $rd && r="${BLUE}${_H39}${RESET}"
        printf '%s%s%s%s%s%s%s%s%s%s%s\n' \
            "$BLUE" "$lb" "$RESET" "$l" "$BLUE" "$mid" "$RESET" "$r" "$BLUE" "$rb" "$RESET"
    done
}

print_alerts() {
    box_close   # closes the two-column split back to full width (╠══╩══╣)
    box_row "$(rpad "  ${YELLOW}◈ ALERTS${RESET}" $(( 78 + ${#YELLOW} + ${#RESET} )))"

    if [[ ${#ALERT_LINES[@]} -eq 0 ]]; then
        box_row "$(rpad "    ${DIM}No recent warnings or errors${RESET}" $(( 78 + ${#DIM} + ${#RESET} )))"
    else
        local line
        for line in "${ALERT_LINES[@]}"; do
            local color="$DIM"
            [[ "$line" =~ ([Ww][Aa][Rr][Nn]|[Ww][Rr][Nn]) ]] && color="$ORANGE"
            [[ "$line" =~ [Ee][Rr][Rr] ]] && color="$RED"
            box_row "$(rpad "    ${color}${line}${RESET}" $(( 78 + ${#color} + ${#RESET} )))"
        done
    fi
}

print_amendments() {
    box_mid

    if [[ "$AMD_ERROR" == "true" ]]; then
        box_row "$(rpad "  ${YELLOW}◈ AMENDMENTS${RESET}" $(( 78 + ${#YELLOW} + ${#RESET} )))"
        box_row "$(rpad "    ${DIM}amendments unavailable${RESET}" $(( 78 + ${#DIM} + ${#RESET} )))"
        return
    fi

    local count
    count=$(printf '%s' "$AMD_JSON" | jq 'length' 2>/dev/null || echo '0')

    # Centered section header with ─ dashes
    local label="PENDING AMENDMENTS (${count})"
    local label_len=${#label}
    local dashes=$(( 78 - label_len - 2 ))
    local left=$(( dashes / 2 ))
    local right=$(( dashes - left ))
    local hdash_l="" hdash_r="" _i
    for (( _i=0; _i<left;  _i++ )); do hdash_l+="─"; done
    for (( _i=0; _i<right; _i++ )); do hdash_r+="─"; done
    box_row "${BLUE}${hdash_l} ${label} ${hdash_r}${RESET}"

    if [[ "$count" == "0" ]]; then
        box_row "$(rpad "    ${DIM}no pending amendments${RESET}" $(( 78 + ${#DIM} + ${#RESET} )))"
        return
    fi

    # Column headers
    box_row "$(rpad "  Name                                 Vote  Status" 78)"
    local div=""
    for (( _i=0; _i<76; _i++ )); do div+="─"; done
    box_row "$(rpad "  ${DIM}${div}${RESET}" $(( 78 + ${#DIM} + ${#RESET} )))"

    # Data rows — AMD_JSON is already sorted (majority first, then alpha) by metrics server
    while IFS= read -r entry; do
        local name vote supported majority
        name=$(printf '%s' "$entry"     | jq -r '.name      // ""')
        vote=$(printf '%s' "$entry"     | jq -r '.vote      // "no"')
        supported=$(printf '%s' "$entry" | jq -r '.supported // false')
        majority=$(printf '%s' "$entry"  | jq -r '.majority  // false')

        # Name: truncate to 35 chars, pad to 35
        local name_padded
        name_padded=$(rpad "${name:0:35}" 35)

        # Vote: 3 visible chars, colored
        local vote_str vote_color
        if [[ "$vote" == "yes" ]]; then
            vote_str="YES"; vote_color="$GREEN"
        else
            vote_str="NO "; vote_color="$RED"
        fi
        local vote_padded
        vote_padded=$(rpad "${vote_color}${vote_str}${RESET}" \
            $(( 3 + ${#vote_color} + ${#RESET} )))

        # Status: 33 visible chars, colored
        local status_str status_color
        if [[ "$majority" == "true" ]]; then
            status_str="★ MAJORITY"
            status_color="$ORANGE"
        elif [[ "$supported" == "false" ]]; then
            status_str="pending · unsupported"
            status_color="$DIM"
        else
            status_str="pending"
            status_color="$DIM"
        fi
        local status_padded
        status_padded=$(rpad "${status_color}${status_str}${RESET}" \
            $(( 33 + ${#status_color} + ${#RESET} )))

        box_row "  ${name_padded}  ${vote_padded}   ${status_padded}"
    done < <(printf '%s' "$AMD_JSON" | jq -c '.[]' 2>/dev/null)
}

print_identity() {
    local pubkey="unknown" revoked="false" domain="${VALIDATOR_DOMAIN:-}" seq="?"
    if [[ -n "$VALIDATOR_JSON" && -f "$VALIDATOR_JSON" ]]; then
        pubkey=$(jq -r '.public_key // "unknown"' "$VALIDATOR_JSON" 2>/dev/null)
        revoked=$(jq -r '.revoked // false'       "$VALIDATOR_JSON" 2>/dev/null)
        domain=$(jq -r --arg d "${VALIDATOR_DOMAIN:-}" '.domain // $d' "$VALIDATOR_JSON" 2>/dev/null)
        seq=$(jq -r '.token_sequence // "?"'      "$VALIDATOR_JSON" 2>/dev/null)
    fi

    local key_short="${pubkey:0:6}···${pubkey: -4}"
    local rev_color="$GREEN" rev_label="NO"
    [[ "$revoked" == "true" ]] && { rev_color="$RED"; rev_label="YES ⚠"; }

    # Ensure domain fits within the 78-char budget
    # Fixed chars: 59 (prefix + key + separators). Available = 78-59=19.
    local max_domain=$(( 19 - ${#rev_label} ))
    [[ ${#domain} -gt $max_domain ]] && domain="${domain:0:$max_domain}"

    # Build the plain-text version for length measurement
    local plain="  ◈ IDENTITY  Key: ${key_short}  ·  Domain: ${domain}  ·  Revoked: ${rev_label}"
    local plain_len=${#plain}
    local trail=$(( 78 - plain_len ))
    (( trail < 0 )) && trail=0

    box_mid
    box_row "  ${YELLOW}◈ IDENTITY${RESET}  Key: ${CANVAS}${key_short}${RESET}  ·  Domain: ${CANVAS}${domain}${RESET}  ·  Revoked: ${rev_color}${rev_label}${RESET}$(printf '%*s' $trail '')"
}

print_footer() {
    box_bottom
    local now
    now=$(date -u '+%Y-%m-%d %H:%M:%S UTC')
    local cache_line="⟨ cached ${now} ⟩"
    printf '%s%s%s\n' "$DIM" "$(center_str "$cache_line" 80)" "$RESET"
}

main() {
    VALIDATOR_JSON=$(ls "${VALIDATOR_JSON_DIR:-}"/*.json 2>/dev/null | head -1 || true)

    # Render full dashboard to temp file. On failure, write an error notice instead.
    {
        collect_data
        print_header
        print_columns
        print_alerts
        print_amendments
        print_identity
        print_footer
    } > "$CACHE_TMP" 2>/dev/null \
    || {
        {
            box_top
            box_row "$(rpad "  ${RED}LFG XRPL VALIDATOR — DASHBOARD RENDER FAILED${RESET}" $(( 78 + ${#RED} + ${#RESET} )))"
            box_row "$(rpad "  ${DIM}Check: sudo journalctl -u ${XRPLD_UNIT} -n 20${RESET}"       $(( 78 + ${#DIM} + ${#RESET} )))"
            box_bottom
        } > "$CACHE_TMP"
    }

    mv "$CACHE_TMP" "$CACHE_FILE"
}

[[ -n "${_SOURCED:-}" ]] || main "$@"
