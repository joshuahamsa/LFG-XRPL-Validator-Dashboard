#!/usr/bin/env bash
# Test harness — sources the render script to test helper functions in isolation.
export LC_ALL=en_US.UTF-8
set -euo pipefail

# Prevent main() from running when we source the render script
_SOURCED=1

# Stub config vars so the render script doesn't need /etc/validator-node/validator.conf
VALIDATOR_JSON_DIR="${TMPDIR:-/tmp}"
VALIDATOR_DOMAIN="test.example.com"
VALIDATOR_USERNAME="testuser"
VALIDATOR_HOME="${TMPDIR:-/tmp}"
METRICS_URL=""
REPO_PATH="$(cd "$(dirname "$0")/.." && pwd)"
XRPL_FEATURES_SRC=""
RIPPLED_CFG="/nonexistent/rippled.cfg"

# shellcheck source=/home/hamsa/motd/motd-validator-render
source "$(dirname "$0")/motd-validator-render"

PASS=0; FAIL=0
ok()   { echo "  PASS: $1"; (( PASS++ )) || true; }
fail() { echo "  FAIL: $1 — got: $(printf '%q' "$2")  want: $(printf '%q' "$3")"; (( FAIL++ )) || true; }
strip_ansi() { printf '%s' "$1" | sed 's/\x1b\[[0-9;]*m//g'; }

echo "=== motd-validator-render helpers ==="

# rpad
r=$(rpad "hi" 5)
[[ "$r" == "hi   " ]]  && ok "rpad: pads to width"     || fail "rpad: pads to width"     "$r" "hi   "
[[ ${#r} -eq 5 ]]      && ok "rpad: length correct"    || fail "rpad: length correct"    "${#r}" "5"

r=$(rpad "toolong" 4)
[[ "$r" == "tool" ]]   && ok "rpad: truncates"         || fail "rpad: truncates"         "$r" "tool"

r=$(rpad "" 3)
[[ ${#r} -eq 3 ]]      && ok "rpad: empty string"      || fail "rpad: empty string"      "${#r}" "3"

# center_str
c=$(center_str "hi" 10)
[[ ${#c} -eq 10 ]]     && ok "center_str: length"      || fail "center_str: length"      "${#c}" "10"
[[ "$c" == "    hi    " ]] && ok "center_str: content"     || fail "center_str: content"     "$c" "    hi    "

# progress_bar (strip ANSI to check visible chars)
b=$(strip_ansi "$(progress_bar 0)")
[[ "$b" == "░░░░░░░░░░" ]]  && ok "progress_bar: 0%"   || fail "progress_bar: 0%"   "$b" "░░░░░░░░░░"

b=$(strip_ansi "$(progress_bar 70)")
[[ "$b" == "███████░░░" ]]  && ok "progress_bar: 70%"  || fail "progress_bar: 70%"  "$b" "███████░░░"

b=$(strip_ansi "$(progress_bar 100)")
[[ "$b" == "██████████" ]]  && ok "progress_bar: 100%" || fail "progress_bar: 100%" "$b" "██████████"

[[ ${#b} -eq 10 ]]          && ok "progress_bar: length" || fail "progress_bar: length" "${#b}" "10"

# format_uptime
u=$(format_uptime 90061)
[[ "$u" == "1d 01h 01m" ]]  && ok "format_uptime: 1d1h1m"  || fail "format_uptime: 1d1h1m"  "$u" "1d 01h 01m"

u=$(format_uptime 3600)
[[ "$u" == "0d 01h 00m" ]]  && ok "format_uptime: 1h"       || fail "format_uptime: 1h"       "$u" "0d 01h 00m"

# format_uptime: float input and full /proc/uptime line format
u=$(format_uptime "3661.42")
[[ "$u" == "0d 01h 01m" ]] && ok "format_uptime: float input" || fail "format_uptime: float input" "$u" "0d 01h 01m"

u=$(format_uptime "6079645.54 111925743.89")
[[ "$u" == "70d 08h 47m" ]] && ok "format_uptime: full uptime line" || fail "format_uptime: full uptime line" "$u" "70d 08h 47m"

u=$(format_uptime "0")
[[ "$u" == "0d 00h 00m" ]] && ok "format_uptime: zero" || fail "format_uptime: zero" "$u" "0d 00h 00m"

# center_str: overlong string truncation
c=$(center_str "this is way too long for five chars" 5)
[[ ${#c} -eq 5 ]] && ok "center_str: truncates overlong" || fail "center_str: truncates overlong" "${#c}" "5"

# progress_bar: no negative input explosion
b=$(strip_ansi "$(progress_bar 0)")
[[ ${#b} -eq 10 ]] && ok "progress_bar: zero is 10 chars" || fail "progress_bar: zero is 10 chars" "${#b}" "10"

# box_row: full-width single-column row must be exactly 80 visible chars
r=$(strip_ansi "$(box_row "$(rpad "hello" 78)")")
[[ ${#r} -eq 80 ]] && ok "box_row: total width 80"   || fail "box_row: total width 80"   "${#r}" "80"
[[ "${r:0:1}" == "║" ]] && ok "box_row: starts with ║" || fail "box_row: starts with ║" "${r:0:1}" "║"
[[ "${r: -1}" == "║" ]] && ok "box_row: ends with ║"   || fail "box_row: ends with ║"   "${r: -1}" "║"

r=$(strip_ansi "$(box_row2 "$(rpad "left" 38)" "$(rpad "right" 39)")")
[[ ${#r} -eq 80 ]] && ok "box_row2: total width 80"  || fail "box_row2: total width 80"  "${#r}" "80"

r=$(strip_ansi "$(box_top)")
[[ ${#r} -eq 80 ]] && ok "box_top: total width 80"   || fail "box_top: total width 80"   "${#r}" "80"

# Each banner row must be exactly 59 visible chars
for i in "${!_BANNER[@]}"; do
    row="${_BANNER[$i]}"
    len=${#row}
    [[ $len -eq 59 ]] && ok "banner row $i: 59 chars" || fail "banner row $i: 59 chars" "$len" "59"
done

# Section rows must produce exactly 80 visible chars
# Simulate data so we can call the section function
RPC_STATE="full"; RPC_LEDGER_SEQ="104325241"; RPC_LEDGER_AGE="3"
RPC_LOAD="1"; RPC_PEERS="8"; RPC_PEER_DISC="5"; RPC_AMENDMENT_BLOCKED="false"
SYS_CPU_PCT=45; SYS_RAM_PCT=52; SYS_RAM_USED_GB="33.2"; SYS_RAM_TOTAL_GB="62"
SYS_DISK_USED="130G"; SYS_DISK_TOTAL="455G"; SYS_DISK_PCT=30; SYS_UPTIME="13d 01h 07m"

# Capture output and check each box line is 80 visible chars
vs_pass=0; vs_fail=0
while IFS= read -r line; do
    stripped=$(strip_ansi "$line")
    len=${#stripped}
    if [[ "$stripped" =~ ^[╔╠╚║] ]]; then
        if [[ $len -eq 80 ]]; then
            ok "validator+system: row width 80 (sample)"
            vs_pass=$(( vs_pass + 1 ))
            break  # one pass is enough for this check
        else
            fail "validator+system: row width 80" "$len" "80"
            vs_fail=$(( vs_fail + 1 ))
            break
        fi
    fi
done < <(print_validator_system)

echo ""
echo "=== print_validator_system CPU temp/power rows ==="

# Set up system data with temp and power
SYS_CPU_TEMP_C=55
SYS_CPU_W=12.3

# Temp row should be 80 visible chars
temp_ok=false
while IFS= read -r line; do
    stripped=$(strip_ansi "$line")
    if [[ "$stripped" =~ "Temp" && "$stripped" =~ "°C" ]]; then
        [[ ${#stripped} -eq 80 ]] \
            && ok "CPU temp row: width 80" \
            || fail "CPU temp row: width 80" "${#stripped}" "80"
        [[ "$stripped" =~ "55°C" ]] \
            && ok "CPU temp row: value present" \
            || fail "CPU temp row: value present" "$stripped" "contains 55°C"
        temp_ok=true; break
    fi
done < <(print_validator_system)
$temp_ok || fail "CPU temp row: found" "" "row with Temp + °C"

# CPU W row should be 80 visible chars
cpuw_ok=false
while IFS= read -r line; do
    stripped=$(strip_ansi "$line")
    if [[ "$stripped" =~ "CPU W" && "$stripped" =~ "W" ]]; then
        [[ ${#stripped} -eq 80 ]] \
            && ok "CPU W row: width 80" \
            || fail "CPU W row: width 80" "${#stripped}" "80"
        [[ "$stripped" =~ "12.3W" ]] \
            && ok "CPU W row: value present" \
            || fail "CPU W row: value present" "$stripped" "contains 12.3W"
        cpuw_ok=true; break
    fi
done < <(print_validator_system)
$cpuw_ok || fail "CPU W row: found" "" "row with CPU W"

# Null temp: no Temp row should appear
SYS_CPU_TEMP_C=""
SYS_CPU_W=""
temp_absent=true
while IFS= read -r line; do
    stripped=$(strip_ansi "$line")
    if [[ "$stripped" =~ "Temp" && "$stripped" =~ "°C" ]]; then
        temp_absent=false; break
    fi
done < <(print_validator_system)
$temp_absent \
    && ok "CPU temp row: absent when empty" \
    || fail "CPU temp row: absent when empty" "" "no Temp row"

# ── print_amendments ─────────────────────────────────────────────────────────
echo ""
echo "=== print_amendments ==="

# Test 1: all box rows are 80 visible chars with amendment data
AMD_JSON='[{"name":"AMMClawback","vote":"yes","supported":true,"majority":true},{"name":"Batch","vote":"no","supported":false,"majority":false}]'
AMD_ERROR=false
amd_w_pass=0; amd_w_fail=0
while IFS= read -r line; do
    stripped=$(strip_ansi "$line")
    if [[ "$stripped" =~ ^[╠║] ]]; then
        if [[ ${#stripped} -eq 80 ]]; then
            (( amd_w_pass++ )) || true
        else
            fail "print_amendments: row width 80" "${#stripped}" "80"
            (( amd_w_fail++ )) || true
        fi
    fi
done < <(print_amendments)
[[ $amd_w_pass -gt 0 && $amd_w_fail -eq 0 ]] \
    && ok "print_amendments: all rows width 80 (with data)" \
    || fail "print_amendments: all rows width 80 (with data)" "${amd_w_fail} bad rows" "0 bad rows"

# Test 2: empty state row is 80 visible chars
AMD_JSON='[]'
AMD_ERROR=false
amd_empty_ok=false
while IFS= read -r line; do
    stripped=$(strip_ansi "$line")
    if [[ "$stripped" =~ ^║ ]]; then
        [[ ${#stripped} -eq 80 ]] \
            && { ok "print_amendments: empty state row width 80"; amd_empty_ok=true; } \
            || fail "print_amendments: empty state row width 80" "${#stripped}" "80"
        break
    fi
done < <(print_amendments)
$amd_empty_ok || fail "print_amendments: empty state produced no rows" "" "at least one row"

# Test 3: error state row is 80 visible chars
AMD_JSON='[]'
AMD_ERROR=true
amd_err_ok=false
while IFS= read -r line; do
    stripped=$(strip_ansi "$line")
    if [[ "$stripped" =~ ^║ ]]; then
        [[ ${#stripped} -eq 80 ]] \
            && { ok "print_amendments: error state row width 80"; amd_err_ok=true; } \
            || fail "print_amendments: error state row width 80" "${#stripped}" "80"
        break
    fi
done < <(print_amendments)
$amd_err_ok || fail "print_amendments: error state produced no rows" "" "at least one row"
AMD_ERROR=false

# Test 4: YES vote text present in data row
AMD_JSON='[{"name":"AMMClawback","vote":"yes","supported":true,"majority":false}]'
AMD_ERROR=false
found_yes=false
while IFS= read -r line; do
    stripped=$(strip_ansi "$line")
    if [[ "$stripped" =~ "AMMClawback" && "$stripped" =~ "YES" ]]; then
        ok "print_amendments: YES vote rendered"; found_yes=true; break
    fi
done < <(print_amendments)
$found_yes || fail "print_amendments: YES vote rendered" "" "row with AMMClawback + YES"

# Test 5: MAJORITY status present in data row
AMD_JSON='[{"name":"fixSomething","vote":"yes","supported":true,"majority":true}]'
AMD_ERROR=false
found_maj=false
while IFS= read -r line; do
    stripped=$(strip_ansi "$line")
    if [[ "$stripped" =~ "fixSomething" && "$stripped" =~ "MAJORITY" ]]; then
        ok "print_amendments: MAJORITY status rendered"; found_maj=true; break
    fi
done < <(print_amendments)
$found_maj || fail "print_amendments: MAJORITY status rendered" "" "row with fixSomething + MAJORITY"

# Test 6: NO vote text present in data row
AMD_JSON='[{"name":"AMMClawback","vote":"no","supported":true,"majority":false}]'
AMD_ERROR=false
found_no=false
while IFS= read -r line; do
    stripped=$(strip_ansi "$line")
    if [[ "$stripped" =~ "AMMClawback" && "$stripped" =~ "NO" ]]; then
        ok "print_amendments: NO vote rendered"; found_no=true; break
    fi
done < <(print_amendments)
$found_no || fail "print_amendments: NO vote rendered" "" "row with AMMClawback + NO"

# Test 7: pending status (majority=false, supported=true) — check width too
AMD_JSON='[{"name":"fixPending","vote":"no","supported":true,"majority":false}]'
AMD_ERROR=false
found_pending=false
while IFS= read -r line; do
    stripped=$(strip_ansi "$line")
    if [[ "$stripped" =~ "fixPending" ]]; then
        [[ ${#stripped} -eq 80 ]] \
            && ok "print_amendments: pending row width 80" \
            || fail "print_amendments: pending row width 80" "${#stripped}" "80"
        [[ "$stripped" =~ "pending" ]] \
            && ok "print_amendments: pending status rendered" \
            || fail "print_amendments: pending status rendered" "$stripped" "contains pending"
        found_pending=true; break
    fi
done < <(print_amendments)
$found_pending || fail "print_amendments: pending row found" "" "row with fixPending"

# Test 8: pending · unsupported status — check width too
AMD_JSON='[{"name":"CryptoConditions","vote":"no","supported":false,"majority":false}]'
AMD_ERROR=false
found_unsup=false
while IFS= read -r line; do
    stripped=$(strip_ansi "$line")
    if [[ "$stripped" =~ "CryptoConditions" ]]; then
        [[ ${#stripped} -eq 80 ]] \
            && ok "print_amendments: unsupported row width 80" \
            || fail "print_amendments: unsupported row width 80" "${#stripped}" "80"
        [[ "$stripped" =~ "unsupported" ]] \
            && ok "print_amendments: pending unsupported status rendered" \
            || fail "print_amendments: pending unsupported status rendered" "$stripped" "contains unsupported"
        found_unsup=true; break
    fi
done < <(print_amendments)
$found_unsup || fail "print_amendments: unsupported row found" "" "row with CryptoConditions"

echo ""
echo "=== amendment fallback (AMD_ERROR path) ==="

# Verify AMD_ERROR=true when AMD_JSON is empty
AMD_JSON='[]'
AMD_ERROR=true
amd_err_width_ok=false
while IFS= read -r line; do
    stripped=$(strip_ansi "$line")
    if [[ "$stripped" =~ ^║ ]]; then
        [[ ${#stripped} -eq 80 ]] \
            && ok "fallback error state: row width 80" \
            || fail "fallback error state: row width 80" "${#stripped}" "80"
        amd_err_width_ok=true; break
    fi
done < <(print_amendments)
$amd_err_width_ok || fail "fallback error state: produced row" "" "at least one row"
AMD_ERROR=false

# ── LFG palette ──────────────────────────────────────────────────────────────
echo ""
echo "=== LFG palette (matches starship-lfg.toml) ==="

check_color() {
    local name="$1" want="$2"
    [[ "${!name:-}" == "$want" ]] && ok "palette: $name" || fail "palette: $name" "${!name:-}" "$want"
}
check_color ORANGE $'\e[38;2;216;144;48m'   # builder_orange #D89030
check_color RED    $'\e[38;2;216;72;48m'    # effing_red     #D84830
check_color BLUE   $'\e[38;2;72;144;192m'   # go_blue        #4890C0
check_color YELLOW $'\e[38;2;240;216;72m'   # hardhat_yellow #F0D848
check_color GREEN  $'\e[38;2;61;163;93m'    # super_green    #3DA35D
check_color CANVAS $'\e[38;2;236;234;228m'  # canvas         #ECEAE4

echo ""
echo "=== print_header banner ==="

# Banner rows: 80 visible chars, and L / F / G / XRPL in orange / red / blue / canvas
# print_header = box top, 6 banner rows, subtitle
mapfile -t header_lines < <(print_header)
[[ ${#header_lines[@]} -eq 8 ]] \
    && ok "print_header: 8 lines" \
    || fail "print_header: 8 lines" "${#header_lines[@]}" "8"
for i in "${!_BANNER[@]}"; do
    line="${header_lines[$(( i + 1 ))]:-}"
    stripped=$(strip_ansi "$line")
    [[ ${#stripped} -eq 80 ]] \
        && ok "banner row $i: width 80" \
        || fail "banner row $i: width 80" "${#stripped}" "80"
    row="${_BANNER[$i]}"
    want="${ORANGE}${row:0:8}${RESET}${RED}${row:8:8}${RESET}${BLUE}${row:16:9}${RESET}${CANVAS}${row:25}${RESET}"
    [[ "$line" == *"$want"* ]] \
        && ok "banner row $i: LFG wordmark colours" \
        || fail "banner row $i: LFG wordmark colours" "$line" "contains $want"
done

echo ""
echo "Results: ${PASS} passed, ${FAIL} failed"
[[ $FAIL -eq 0 ]]
